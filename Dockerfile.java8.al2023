FROM scratch
ADD x86_64/1ba64f407991cafc4f5e2e673ede62f2f74281e76f7e7415984b38c731fac5c9.tar.xz /
ADD x86_64/37711d58c38a1185d8b405cf564609108a5907671cf39b254c5ebcbbfc6144b4.tar.xz /
ADD x86_64/55d0225afd8b2f744ab37a271e1f8aa8d5256986b77771ab3e281c350a29817f.tar.xz /
ADD x86_64/5efdb60809a7fbf82c4afec09ab7e538538f27432ba9d7962108258896806da4.tar.xz /
ADD x86_64/7006352ea7165b2b9c8b9e499d52a29563619a2e32f276cf8b6f57260594b763.tar.xz /
