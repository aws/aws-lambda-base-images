FROM scratch
ADD x86_64/2037b035da3353d952fef9420e82747ecb760d6e9bcbbf75193c36e43a00878c.tar.xz /
ADD x86_64/2cf806702ccbf5ca2ab000c6eeb6d8f00eac0576cacac128b29bb3c8382b459e.tar.xz /
ADD x86_64/55d0225afd8b2f744ab37a271e1f8aa8d5256986b77771ab3e281c350a29817f.tar.xz /
ADD x86_64/6b8b7fd21e6b92536915252980ed1b26c88436367e15c79665c8acde4b4e497e.tar.xz /
ADD x86_64/8685d1a53991d4bd4ad74daf707b511b00afca30225c295c6c0b8d96ece39e39.tar.xz /
