FROM scratch
ADD x86_64/697eaf2430c2a7d808d64b8589cc189ac861a27bcb66bc5d2f2bcbd273249231.tar.xz /
ADD x86_64/6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD x86_64/70f1db3f2343cc230e783ca99d4af0ee3846a70780609ae2c988041cdf12c359.tar.xz /
ADD x86_64/98af3168f8711345d23b4e3c1242f9da21281b8ee983b763fdb0868ac8320852.tar.xz /
ADD x86_64/a429f577394bf1e30255708fb22f6608856a3c66aae487635bec247b9b2744d6.tar.xz /
ADD x86_64/ab72d24b6e54c0f302c289b8c6a80cb7fca1e64c01b6d29b494cec68ceb2faad.tar.xz /

ENV LANG=en_US.UTF-8
