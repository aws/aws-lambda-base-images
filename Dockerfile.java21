FROM scratch
ADD x86_64/5cb2c3c01ec667965b57e24c0fb7cc87c92c402188ae2d864a14d13a99bc0dd7.tar.xz /
ADD x86_64/9e4271fb44e52c46f2dea1efe415e26389826019e7b9907561ce4dd3a98ca9ef.tar.xz /
ADD x86_64/a825d4fef74c46fdcae0d709bf2e83dd0ba0d5c0fd9401fe0ae48fe25b846378.tar.xz /
ADD x86_64/aedad9e00ceb84905f55f692da4f8bfc4ad8e5357b08b01382f964d2b4e7255a.tar.xz /
ADD x86_64/bbb6c266accd6a87a94c7d326f7276ddb28d878cd53793f524c4d90bd05750c7.tar.xz /
