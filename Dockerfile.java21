FROM scratch
ADD x86_64/2cf6f32fb6cc1edb69ae5987f1a636a02f21b7c831bf2a5878f80c47ff268ff7.tar.xz /
ADD x86_64/369fdda67d93b3ca923d89dc8ff74088415c8e3349a57175b3f36c0220ec4415.tar.xz /
ADD x86_64/6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD x86_64/b036f4f798ca6404be6780a1d91d5a0cdb8f8f5cbbab2bb558391ee1a145a0c9.tar.xz /
ADD x86_64/c94b0d67fc32cbe207e401b3b4d75db524f8d352ec84be49bce17259ca03cba4.tar.xz /
