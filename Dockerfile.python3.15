FROM scratch
ADD x86_64/04e4e90bc50775bfdf3fd250b687ccaaff7e642869178a58b57fa847674cc3f7.tar.xz /
ADD x86_64/656ba2b39cca8a890d742b5eedc94dbda29c0425f1f5e1ac7ac5df764b9bdac7.tar.xz /
ADD x86_64/6761fbb6b1f9187d18e10c8b8897523d9cc1c9e0fa9a9640f92f2f5f1275ec75.tar.xz /
ADD x86_64/a583b79a6aa08eb791dd1321ecbd441cef954f74372bc74b1c8be0f8aa2e439a.tar.xz /
ADD x86_64/c76e15ac82e8ecf6fb8415d099a8a821f49c6ac52f370e8559555205c56390e5.tar.xz /
