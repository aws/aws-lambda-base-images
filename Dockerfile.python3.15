FROM scratch
ADD x86_64/25309bcae080da99d2d545dd3c5bb1ff5773d6ba7655f23324ed0fcfab9ee0a5.tar.xz /
ADD x86_64/6ef0ad5f0ccfd8dc749b718a3578d338502c3a0fd59c6a7764787fafc6893ad5.tar.xz /
ADD x86_64/83f1373e0dbe418a8649fd61495b90e04fced6b5dbbcbe71921689be365952ab.tar.xz /
ADD x86_64/a5e7f93d7d595166b0f9f15540870abf7b623e6f55b16466d9f52f83f5fe3cef.tar.xz /
ADD x86_64/b3efadfcfb953a4330ac7b8df8a8613a4b3593da69de93008205285d6a2b97f6.tar.xz /
