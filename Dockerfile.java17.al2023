FROM scratch
ADD x86_64/47187cea13eb00ac802c38dc5cc63a5c62cb19c86b8ea55102563fa8d6104221.tar.xz /
ADD x86_64/4e873e77e4adbfe62441a104a451f97ca2ad849dad9ca7f4cd273c3c8378a638.tar.xz /
ADD x86_64/6b650676baea64257084c1a058e2856f5662848018ad764e4ffe2ad4eb1c8aa6.tar.xz /
ADD x86_64/71bb89459c5426bf5d8694dd19cef123df434bbe3470e51d9aeef81294010a8d.tar.xz /
ADD x86_64/9f76aec384ef285b3fb7706d752ca38979ea90e91e81228f0734134f3a3644bc.tar.xz /
