FROM scratch

ADD 33fbf585f081acef6a3c4f99ae8d42b81cc567a8d1346c9d3db361705fd079a2.tar.xz /
ADD 456b9b4b7cb79fd4056a1c1c426774650f34fb88f65dfa4e9be94add8c6c4901.tar.xz /
ADD 4e1fc7ca1e1c8a014a615035d641435129bf36f8568110dcd7f4b8641d830616.tar.xz /
ADD 6cedb657f66b28b22d838d8957c21793dd5ea89d72a6659d0831f05f3e20a9e4.tar.xz /
ADD 6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD 7cde0ea5795f2c1ea398ad0c3fbfba5c52439e6e8b72e34e05269cbb05cda555.tar.xz /
ADD aff21d24d56e359f865ddbd8ed0df5d4a9befc1876c4cf1b5eee7a33149ff092.tar.xz /
ADD f062cf79fba9a65d823b1ca927f0d8905048d46d11b0f5bc3e12d96cc4618803.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=10.0.15
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
