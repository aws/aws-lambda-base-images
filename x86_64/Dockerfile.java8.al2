FROM scratch

ADD 24d980735e05406c76a5f6cf9f059e89dc5585e119144c437dba3a68933f7797.tar.xz /
ADD 44c3f89424decfb21e8116b7e7172909047a64e69270a6ced498dbb7c2ed5c68.tar.xz /
ADD 4afdfcf99eaaf64977bec7569d648dd1eae13be4733777d37a2e3e8432801ea1.tar.xz /
ADD 6742890f0654e9e82a518f5e90ef8b281f5eb05920087be0ed347c1fd2ada4a1.tar.xz /
ADD aa9cf8fade8bca5b742f75979a2b621ff3f1fe0498f6842cf7ca17fc306b7aef.tar.xz /
