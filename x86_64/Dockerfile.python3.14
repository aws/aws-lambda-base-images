FROM scratch

ADD 159fcc9d5e45ca8155fc985432cd0d9f3108848b133b169e08423c41134b3a71.tar.xz /
ADD a3d60a141e3c3e74d61cf01ac6afd2d1125c1ca5f35f3d77d573b3e7517e5f5a.tar.xz /
ADD c99cd150bf867456bdd4098bd7dd3d4910c75541690cabb0899154fa9b732c13.tar.xz /
ADD db9a7d75d20f0f5d9656fc8150319d6f05f8065fe23434a7a24da30178e90149.tar.xz /
ADD eca19fa99794abbf99b9b4eb13f2f116db38383d87ca3230d882656dfd9748ca.tar.xz /
ADD faace1d37570eebb23cb8a08da1ad36fc5c7e5e79abd26c1aa412e7fa037636e.tar.xz /

ENV LANG=en_US.UTF-8
