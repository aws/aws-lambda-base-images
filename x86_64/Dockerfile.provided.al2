FROM scratch

ADD 4003d620d473cd3b6b0f3e09912404cddf2fe6b971743936b00e01c7ce1986cc.tar.xz /
ADD 6525c920301510a77af8244a8a275e98591fb81c831f80d531abc78331806787.tar.xz /
ADD 66f65479a0f3f741c8f4805f4565b44f045b1405cf72a811010cce71abb1dba0.tar.xz /
ADD fa1051706d77fd4f98fcccd8f47a37bbe839fa9ed8bc0820df6a7bee03c8976d.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
