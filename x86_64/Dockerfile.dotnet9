FROM scratch

ADD 0ea4aebd40471e4f1248176935e2409f43553bf2135c6a2b4c36950d57ca6f6e.tar.xz /
ADD 16590070de8ad0cb4f6984006bcb864ae90d93d2e5b01baad9384469b6cfc220.tar.xz /
ADD 55d0225afd8b2f744ab37a271e1f8aa8d5256986b77771ab3e281c350a29817f.tar.xz /
ADD 5ff970e16f6ec753a5ed302764af89f3c00ca8e5d23c3aad5e52123984c76006.tar.xz /
ADD 92d2951791e9034718234c6bde3a9b3aa36e9dcc9c701d3bd70d663c051652ab.tar.xz /
ADD ac3532b8490d6c2f03519b0a19b8189cc02adcf5870a16466ba1f6238b67a1bb.tar.xz /
ADD c694d7d6dfd2e34f9b82d9b3028767b93a38ee2a0fbc0e4c783b525b4b40d8f7.tar.xz /
ADD e74d6b6a4d4cbae19d6fd3b4649dafaf7d1d4abc5489ccd0382a8bd9706a8d8e.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=9.0.22
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
