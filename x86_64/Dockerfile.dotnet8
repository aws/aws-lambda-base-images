FROM scratch

ADD 0dc22a6af92e732f6c6bbc0826e9c0ee681f99cf55842e2c28c1ce4d14ed58af.tar.xz /
ADD 0fd6ad146a52245b600954a0c46e6af624d4c1ec25e4a6bccbf4c8f10118daa9.tar.xz /
ADD 368197efc82ef41704d021e1853174e1a2778ef5472b28c335d4543a20c74f4b.tar.xz /
ADD 4a5e6d0b467f30b3915540fc6eed2153f96a5f8eb513a09c61992e2c8ed5ab5b.tar.xz /
ADD 4f6da17c44d9ad57c059619defe0c4eab60a8a6a537c5df007f2630c615e0b6b.tar.xz /
ADD c4487a1c7203615814c47cb1402077f7b9c5c38df3086ce1f999ea6d33e8ccfb.tar.xz /
ADD c914f08cd9bffb606b199952fa0fb3a3a049c9a14c4c392ddba9d9f9cca1147d.tar.xz /
ADD de7f0f7722e6bb99741bc0db1c2d7c6ea9ba3731a7a0221d8f2ae5eca4be9c87.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=8.0.32
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
