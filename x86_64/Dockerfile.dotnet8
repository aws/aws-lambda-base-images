FROM scratch

ADD 0b4361ec95693bf4696bd8e850e5ab0c6426ebb8b83a8c3a15ebbd2f2f557b1a.tar.xz /
ADD 1ff0df6dbdbb83926effa406336a49ed7b604c17f3f99da08936fe1effc696d7.tar.xz /
ADD 33283bcfc91a1ae169d1d56898b1ed41625cd3309918f84b515943ad14dc23cb.tar.xz /
ADD 6bbe28c1eba45f28471f27df801f2b790a957eecd5a3555b8206e1d0ad6bda96.tar.xz /
ADD 97291728bcbab0d03b691f19f989ab87f2f8b02a0ac6a7af971a5f18ab1967a7.tar.xz /
ADD 9f76aec384ef285b3fb7706d752ca38979ea90e91e81228f0734134f3a3644bc.tar.xz /
ADD b7c1a6ff70e49a5a324d95a666672488bc8c9ca08c4b8774aff1637896de4184.tar.xz /
ADD cd3ca03020f38691fca9c52eac0821252030b8ed946226ecb16f5fe248c696ef.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=8.0.30
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
