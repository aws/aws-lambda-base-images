FROM scratch

ADD 84f65b693737697a3f0e113eaef222fbc283931f343aa32a574008f7bd9b4646.tar.xz /
ADD 88c4d499e005212e91f6252f66a22562d3617ef7807b38fd335e43c04ce65a00.tar.xz /
ADD 9678bcc862cab1ee591b9b0755bf673b51d640f3e6e183ab47b08eb42c2d807c.tar.xz /
ADD cc50b96790b35f45fe956fbf9a434a8066cff021817ea0eab46426e9223c7c47.tar.xz /
ADD cfcbd217afad99e36e8d969ddbb605f6e74f9e98b4952efb83192d0f52eddd8e.tar.xz /
