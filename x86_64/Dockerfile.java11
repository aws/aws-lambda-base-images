FROM scratch

ADD 0f1ae767035e34e913de3eb1a59c1b7ee65ccf2a1a0d4628ba00b3486aabac4d.tar.xz /
ADD 5f27b9ac26385944c3ca773bff049adef2cecae82c6b51eb699c6de275f639b4.tar.xz /
ADD 6525c920301510a77af8244a8a275e98591fb81c831f80d531abc78331806787.tar.xz /
ADD b729be5185d53964f11f8d4ff83a3e5524b6378b0e83df005df919a4950483cb.tar.xz /
ADD bbafbea2a9817c6a8a17b94c8ed031f09130a0f8a6dc4fe44219defd7ce07d80.tar.xz /
ADD cee7b2d9681510cdd02120da20dbb5fab79903a925e27227bed21d081f29deb4.tar.xz /

ENV LANG=en_US.UTF-8
