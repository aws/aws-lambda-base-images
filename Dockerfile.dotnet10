FROM scratch
ADD x86_64/112dba02225249e6a189012f4a4400c63eda53ea998225112e62be44875e3aba.tar.xz /
ADD x86_64/1f3b07bb230982ccbef152abf8a8a95523cb909141008196e0c802df2b11e212.tar.xz /
ADD x86_64/1fb6d71676bf2bc7eacd74dc88a8130db8e18832783482e0c2ed3a45caa03d03.tar.xz /
ADD x86_64/3f8dae83e04d7acd3aa4daf78f2fe18fed0db02c4078382936ac726d68b9daeb.tar.xz /
ADD x86_64/492ed3e0a388ee2165fb124d16dc753405d7bc9c2b8c0895b9d4df8ae6bdd354.tar.xz /
ADD x86_64/9146d3f476aadb9eda82a9e376efb9cf111aa031e2923f5dbb6e8d1a6df9f033.tar.xz /
ADD x86_64/c914f08cd9bffb606b199952fa0fb3a3a049c9a14c4c392ddba9d9f9cca1147d.tar.xz /
