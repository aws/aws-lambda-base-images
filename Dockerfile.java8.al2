FROM scratch
ADD x86_64/14b8ced20ff5e6132af58fddbbd8bf2bf6e2a08bba228e1e2f3029069af47096.tar.xz /
ADD x86_64/6525c920301510a77af8244a8a275e98591fb81c831f80d531abc78331806787.tar.xz /
ADD x86_64/682436677cf95cfc9c431e331f7df8f091feb17555128c2661275381ee71cc44.tar.xz /
ADD x86_64/6cec2829fb4e77b8e32747b8d4e53caac4cbb6dadf23d0d695a43b2162b29d0d.tar.xz /
ADD x86_64/7462b3e5d49b55d858891d140d6e626a449d5438ce17f249ee5d058997f47b00.tar.xz /
