FROM scratch
ADD x86_64/3159e4a5e55c1c79c0cb8afc997514f455482a626b06adcd99bbcaac6345ae62.tar.xz /
ADD x86_64/3194cb27c39c6bc4c2c9bcd7118ec28fde4d1b1eb05c194cc0d3f146a1f87184.tar.xz /
ADD x86_64/3199a8dc7abafc93b2ca656a6f9699cab54578e80c836be0f5ee6b8ce913e44a.tar.xz /
ADD x86_64/55d0225afd8b2f744ab37a271e1f8aa8d5256986b77771ab3e281c350a29817f.tar.xz /
ADD x86_64/99b78ded644db0b8aa77b2806cc06ea0962fc748c995aeb60f0474167748bd16.tar.xz /
