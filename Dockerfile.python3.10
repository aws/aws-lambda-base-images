FROM scratch
ADD x86_64/1b67c39fd17a714774848178440be13624e7931380dffbcacd73985cb10fc5ce.tar.xz /
ADD x86_64/986e7327905f033ce20d6c2da939fe81c1c3f5cfe2f3061c3f4ab4a7185d3d96.tar.xz /
ADD x86_64/b0cf7886a4bda876f5f9e00964eb954a1706862a7cf6059ccdb1bd48ae34de59.tar.xz /
ADD x86_64/b8c6068a2b8ef08b3a9b7ec588aacff5ccb0f6e97a62ad841fc5bb7879ece578.tar.xz /
ADD x86_64/eb7e416aafcc039bf71fdb8722b6061c73488f6ba3e8c152acb51ebf04e86c8f.tar.xz /
