FROM scratch
ADD x86_64/227f01ea8d6d200deed4d4464a7ddeb84e0c2687cec9e663dbb0e6ac8fa9a531.tar.xz /
ADD x86_64/5691653010839a36f4cedd9e28f9dff98c9fce84decda19da058eb59bba8a701.tar.xz /
ADD x86_64/6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD x86_64/bb39ef5ed53108ff870888b56d6148c8a2deac7c70f46f889782e9815e188433.tar.xz /
ADD x86_64/bef2630ba1e87bb6741997f640cd0353f640e954d5fc8e57e43481c21d8b09e8.tar.xz /
