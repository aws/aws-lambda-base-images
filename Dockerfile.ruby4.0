FROM scratch
ADD x86_64/499f5bd801a082d0b4a66fd46cf3ccc170f328b0d026cc58b9cb4c3bfe09277f.tar.xz /
ADD x86_64/55d0225afd8b2f744ab37a271e1f8aa8d5256986b77771ab3e281c350a29817f.tar.xz /
ADD x86_64/68cca47d5b55ac624116120618fa9bf354fcb1d35c0d0362601baf468e68efb4.tar.xz /
ADD x86_64/6b25512e20e0a4b950efddb8bcb7aaa478469934dd290bcfc0d09df8876e5659.tar.xz /
ADD x86_64/af9f9da02f379ee04561008c912dced4aa6d1883305cf57f80716879d76aa123.tar.xz /
