FROM scratch
ADD x86_64/2c7df50ae4439b1d1f036fcb964fee675488b2c52b1c602b5ba09851f991eda1.tar.xz /
ADD x86_64/42e2aa925993b9793e133dc4ae54915525fdebf0370396d7fa3e4d0acb5048e6.tar.xz /
ADD x86_64/54eacdc18cc127345d1c8ebfb58df065567854b0f2545f0b74b749275f5bad8e.tar.xz /
ADD x86_64/6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD x86_64/7143823916f6541c852a1735200727f2bad3492eaf6724b8087ae8ac5b59b691.tar.xz /
