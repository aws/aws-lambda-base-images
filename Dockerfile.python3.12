FROM scratch
ADD x86_64/206e474b02de852ca297a9dcfa6afc2e12b26e8750848d7b1ac84852cb06cd87.tar.xz /
ADD x86_64/730c9ec542ea994afc910d1c6313c640d6843cb77c2c562e1d373d5eaa051b73.tar.xz /
ADD x86_64/8e8bd9ac5e6cf467f5db341754ca5fd665756649552f7fef2beadadb2ddf2b3f.tar.xz /
ADD x86_64/c914f08cd9bffb606b199952fa0fb3a3a049c9a14c4c392ddba9d9f9cca1147d.tar.xz /
ADD x86_64/decada3efe22c7d3581ac5a3a0b77a8dc25932e8078b62f252426b62b5e216e0.tar.xz /
