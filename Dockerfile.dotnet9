FROM scratch
ADD x86_64/0790b84514c11a56a46fa47daed8f2509eaf0e0049b1875dda36bd8fe10dc1b9.tar.xz /
ADD x86_64/3eb04496ea392d78874fc5fcfbd4a564a98d041aaaf3685b4206c231a8a195c8.tar.xz /
ADD x86_64/413eb2969384571e9f2ea4f5b8293bce297b63c29a4c509bf70f5f2ee8a4a39b.tar.xz /
ADD x86_64/43238042aedb1a43cc01b869794b4a9afb1a8b22c39192c178196485bdc68796.tar.xz /
ADD x86_64/5bcb57542ecde06884307bc1adeb13f766708c17ed0f6c5d5b73cbec345da997.tar.xz /
ADD x86_64/9b3d9818a22886ad9a21d305c8a7d8ca6d3fe01c0d35352fa34a6ae9881333bd.tar.xz /
ADD x86_64/9de8b6a040112865c4bff3abca4bebcfa2bf3f4b927a8ed5b0edbd065e1812ca.tar.xz /
ADD x86_64/9f76aec384ef285b3fb7706d752ca38979ea90e91e81228f0734134f3a3644bc.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=9.0.19
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
