FROM scratch
ADD x86_64/3618993a28e8fedd39fefab3c22dd3b04008ee5892d83d2787d79cbe7d192aa3.tar.xz /
ADD x86_64/3ee7fa7ded0e81b69e0800685130b1e248238da5d47314304aa0b165548ab0c6.tar.xz /
ADD x86_64/501e242b506c3e6140ecfa38c6c6a7c2129ee056d72f26a743c95f4bfc8f1378.tar.xz /
ADD x86_64/5bec7a7f5a6683477a9cb8b620f426b0769ac4e97a447c6ab1c73794359ff7d9.tar.xz /
ADD x86_64/aa55b4752daa626dee286578506460ee8e682637780586e6024ca9626e7773a1.tar.xz /
ADD x86_64/c914f08cd9bffb606b199952fa0fb3a3a049c9a14c4c392ddba9d9f9cca1147d.tar.xz /
ADD x86_64/f2c65a6c4b1080fec2ca01dc0d85bdf56b1d737e7eed318a7647f7f26887664b.tar.xz /
