FROM scratch
ADD x86_64/10dfd471e185953ee9dc46fb21ec78fff875dadf490181edce9840e77717c40e.tar.xz /
ADD x86_64/19892dd59e9d02f47ce1356c37cd736e243c17d414c9c76ba7db2d859330297f.tar.xz /
ADD x86_64/204f34a0763bd565de935d6dd9e3069216162b11f60d024a40fb0f6d72e8d709.tar.xz /
ADD x86_64/36d9bf036bd44d7d569bf83312bf05f6b72f9aca8d39f9b99435677f8f04bfaf.tar.xz /
ADD x86_64/6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD x86_64/905e45fe74d0ec8e7b77a54604ad4aa8ccefeb7a77d599d935d352ece3d5d4fc.tar.xz /
ADD x86_64/d815e4702c23253b1028fa4a2dfb9f4cb05dc6e0aa4780c6c738badc72590cd6.tar.xz /
