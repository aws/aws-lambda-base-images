FROM scratch

ADD 096b3393020153908c05871fcf6768025fe2c43785e9b0f6649f3aaf014e87c5.tar.xz /
ADD 11e2a6b286d04a1697e8ec4c2f75b0efe33bf32c9da6c523a7429b73132e9025.tar.xz /
ADD 35752a263a67eefe0cb8057b54802eff428d047cba417196bec2233b0541314e.tar.xz /
ADD 57d8e42a2d16408465ef29819a6b3fa4299235d0ce18b3f74de1979cde08fcd0.tar.xz /
ADD 7604a8a5ffa3cfd189fafac5fae80d3bf10f353111432ab0513abd8999735cc4.tar.xz /
ADD 8ce4cde6c03dba3ab724fa9269acdce0c14a7c9d70215d117f4655b5e4d6eb54.tar.xz /
ADD 94d812b4b4f7914b0e4d16ac9cc85e71daeeee6e3b8d5a25c3be935d9d67ce85.tar.xz /
ADD d2120e3065c660d6f9d3ef58ea3193e679f874408b8e8b6e55f49329c0c53ec9.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=8.0.31
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
