FROM scratch

ADD 14bf4f182990797156b967935e695a1d9a6a65d901387ea7cc6dc5e1003f9806.tar.xz /
ADD 367e4ad79d201e4380eb228bac50259f953a895fb3a5b04f244bf36b61dbc951.tar.xz /
ADD 3b0d7d4fbc39e40ccb3a29341bc245bc8db1af0c07fc4c1ff3218fb91d9d169d.tar.xz /
ADD 5243b71d0e84ae172f4094db0e71613d6ba57afed4a49aad35e62b9fc3d1c4bc.tar.xz /
ADD 58a0aa358d4c08001b77a9d00e3f43dc444cd1cd94efa224cf4129b1d72e560f.tar.xz /
ADD 5f931a3f9c5afb4fdcb0c6d73d5b23ccc0156a2b2005ac0a4a2aeff9b634ea73.tar.xz /
ADD 692eacab5bf5c05022a0c9f07edf3d2da03b1948a940efd9068e2b5cf483e259.tar.xz /
ADD d373e9d696660de9060c441576099e0d945758f0e961c16057084fd8aeb1a878.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=8.0.33
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
