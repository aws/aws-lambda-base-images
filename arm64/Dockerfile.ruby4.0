FROM scratch

ADD 0f0d721ad7c4d8ea6e32f4206b4f2409b038be9b4b4cb387fd2b92693e708bd3.tar.xz /
ADD 28788f1e5a37c326f12bc88c7e8ec09b3b9ee6b1231555763a425fa2e8e3953a.tar.xz /
ADD 772d76fa9e373c6026f30913d2804928b2d1a58d579e3bee798de0f01cb0cc53.tar.xz /
ADD ac6d3600a5115bf32cdfb1b2e2b104218fa078be1dd5ea8f870101b4f9e61dcb.tar.xz /
ADD e84b43ef833cd90403ad651671a9e2c95dbd3b9f59d7bbf02f47a552946b44be.tar.xz /
ADD f8d0beaeeb623acc85c55242f9680d8e1dbefa6fd68b6da121b49e0d513f1e16.tar.xz /

ENV LANG=en_US.UTF-8
