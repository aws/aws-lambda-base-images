FROM scratch

ADD 0ce7ebf1f98285c95bdcb24954b67c2295aeab70c37963175eeb29b20a1f0087.tar.xz /
ADD 14bf4f182990797156b967935e695a1d9a6a65d901387ea7cc6dc5e1003f9806.tar.xz /
ADD 15a2109b7c1c46d48e08853ec1c044b615ca4558cc27b4bbfbc0cb7c24b2f6fb.tar.xz /
ADD 1cb69df8d138449dcd0261ad198436534817dee4be7a840f076bd7667961d36a.tar.xz /
ADD 33505b5bd9d184378359202ae9cb78480f1b15f086a8ad55e0804c82f2b46532.tar.xz /
ADD b20bad481b92cd4709e734427cdeb6e1f6efa9d8717dd14edb719812e75c830d.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

WORKDIR /var/task

