FROM scratch

ADD 2d55c612303139433e9ec5a65d671d2284840efc418e19d0817e6b7a1c45c328.tar.xz /
ADD 7852200081ea83bf15db89a393c83901f29356e5f3ad7ab06dd77c2081dc67be.tar.xz /
ADD 7c816f6a4aa14542a3df710e447828f9705b38ea7a7500ccbe4678795e29cd5d.tar.xz /
ADD af191c0a3010f8acab4bb7e06e2de41b3eaf8a2808563a8764b7e445e46fe99a.tar.xz /
ADD d2459d29cbd4ee9a1897aef4e51ca8e68652e7162f99c23a078ad529176abc56.tar.xz /
ADD eff8461a9406517967dcae3bea7f052a7899a1e36ce378b519b7358bd0226201.tar.xz /

ENV LANG=en_US.UTF-8
