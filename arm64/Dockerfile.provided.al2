FROM scratch

ADD 59e567cb25d4afcfd85b193514b7f1ec5a4a30e91ed9999402401902f76604aa.tar.xz /
ADD 8e23349b9fdeeb792bfddb382152299432d485e772f57b568aa470a64067b21f.tar.xz /
ADD e5c5088904831fcc73bab54c711478dc5e4abbe542e5ef817bb92f0e6b3b6a76.tar.xz /
ADD f96aad736670458741f61b7451261d818f219b2b99af2adbf4aa3608a1d21aa7.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
