FROM scratch

ADD 121956e87f39b67cc070c1b71026d0f48bd55246d9f238d824c228928f9ae7ef.tar.xz /
ADD 248841ac9a46179261b25ac67cc73a1006ce6ca8064619448681b5c1abdbe484.tar.xz /
ADD 73e8a9894bde2cbcbb7f2ee5a0b66c83d4775a09059fd4c7c708564bed6e15c9.tar.xz /
ADD e5c5088904831fcc73bab54c711478dc5e4abbe542e5ef817bb92f0e6b3b6a76.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
