FROM scratch

ADD 0b68d637455123da8becaad6fc673a6557b6ded72092ce3c8b3cbb2769b2ebfa.tar.xz /
ADD 6c8c89679c123c121ed6ef3ce29ab598af2cf7723a57ad2f58ec887d868c6d81.tar.xz /
ADD 809eaf4a7687a06b6dab0f1441d4b8dc62bea20f8f47b0382fc38a5a6ebdc72f.tar.xz /
ADD 94d812b4b4f7914b0e4d16ac9cc85e71daeeee6e3b8d5a25c3be935d9d67ce85.tar.xz /
ADD c35d9554b781f241bda523c163b56335c0bb7f2bde44e5d7bd67d5b7f90d78e6.tar.xz /
ADD ddb61993d7c4e9d0bdea4a370414a1d7122139a620fae19247f21bca3acf721d.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
