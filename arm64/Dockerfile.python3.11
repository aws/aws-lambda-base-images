FROM scratch

ADD 0e0bce8f831cd48257acc9cfacdc1d57239e9f3a763ec36c6ac0969f78e04962.tar.xz /
ADD 1c4fe55f8fd38efe864d155f0ad2afbbfbff1ac2ade9324063b8e33489e2edb3.tar.xz /
ADD 316f12db0f7448a39939ed318462991eef638da7983062e34c675ae15e77a868.tar.xz /
ADD 6141011e7c920cf072cfdda1219a57afd90399a2fefb1c87e3e4d59cd0ea0dc5.tar.xz /
ADD 7852200081ea83bf15db89a393c83901f29356e5f3ad7ab06dd77c2081dc67be.tar.xz /
ADD a33880606a70dba1cff73de099e641fae65db981ac910234df97e967e51eaf65.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
