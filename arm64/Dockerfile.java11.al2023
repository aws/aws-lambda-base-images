FROM scratch

ADD 1443f06741557cf4c4adbacb33b5cfa84060d4026d6722e16ad8ed654e29cbf8.tar.xz /
ADD 1452371b2c23740094ed354fb008417e7b425b3b12246363a9ef05fcd194b5f1.tar.xz /
ADD 4e406dd072a1eec0b44df30f3b524f800e6214e1178d08f6058c276078f9af47.tar.xz /
ADD 65917727020f4df7518ba60889ebcbc2131bffe24428337e8496a7210d8f231a.tar.xz /
ADD 94d812b4b4f7914b0e4d16ac9cc85e71daeeee6e3b8d5a25c3be935d9d67ce85.tar.xz /
