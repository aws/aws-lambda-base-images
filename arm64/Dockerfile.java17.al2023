FROM scratch

ADD 3f1d8cd6dca663e8213ed9989c37bc13accfef7b7d5cfd03e259864d9f91d343.tar.xz /
ADD 7173f38b93043b5ce57c5830e0e512c32227d71c7f861f2bb8d50ae0c7791649.tar.xz /
ADD 94d812b4b4f7914b0e4d16ac9cc85e71daeeee6e3b8d5a25c3be935d9d67ce85.tar.xz /
ADD b215751d74b9d7de3bacc14988d672db0d8f2e3fc2ddd7031cdd5be7523a69b6.tar.xz /
ADD b5526bf06212b5de02e6913479036265b6937fa99bbaf850f1e31f0f1a50ac9a.tar.xz /
