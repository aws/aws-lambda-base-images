FROM scratch

ADD 1600d5562bc4784f3b1d6e07e23aee0b12fa1549cbf09fd15c65f51c3f135a88.tar.xz /
ADD 7790be9bacce24cb8042b34b261c36f4deba7b2e11776e23142d8bb87deaf145.tar.xz /
ADD 99281b5b60dec0c495bdedbeed657d74bbb901e625948e20963d2e01c73e3bd8.tar.xz /
ADD 9f495abcc6d80b5ec036b1139be06203037436be7c0fe4e5e3218310d7e4d20d.tar.xz /
ADD d1efa4fdb331228ab1d8f3ffcdeb7130bd94afc9f569fd1f9863bae17f4bcce1.tar.xz /
ADD f8d0beaeeb623acc85c55242f9680d8e1dbefa6fd68b6da121b49e0d513f1e16.tar.xz /
ADD f9350ec843c02192f004d75e09c1270601733c2f330b66a4069afdf3fe30741d.tar.xz /
ADD fdcdaa7b6e4535b7e7d3c5b2c53a92eacdf6ce3449f491e89f390985f365b2fd.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=10.0.15
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
