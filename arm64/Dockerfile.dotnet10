FROM scratch

ADD 41c4374a2d2d783a5631f7dfc2b709202c3577613722bcfa47e49324a248f85f.tar.xz /
ADD 48ef2080d59993db5b15e71ac17abe84929016ed54152b166762b620046d61a6.tar.xz /
ADD 51317955236cffa19261fbff63230610e06aab177e466951f3c12c19c5ed6c8f.tar.xz /
ADD 7a060b6ee2fe530a238b07ba70a33b155ee77565c2500766bd9fe49feba1775e.tar.xz /
ADD 8c3e48a0cfc83790771ec1f6905fbd91f34a946a275cc7938d6dee74271baa01.tar.xz /
ADD 94d812b4b4f7914b0e4d16ac9cc85e71daeeee6e3b8d5a25c3be935d9d67ce85.tar.xz /
ADD cabcc0770e6cf08ca4bf6015e847541805af5f7de1b5cbd26bee65d53d39d1d4.tar.xz /
ADD e90aa42dc3ab9538339fcd55357be67ae825ab75a60183b6ed0929aed441ac65.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=10.0.12
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
