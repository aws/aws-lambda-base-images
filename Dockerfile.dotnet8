FROM scratch
ADD x86_64/238074f88a2deee2950e51f04d1be1139996460ac63f3b77bf2b72a363e5e235.tar.xz /
ADD x86_64/4a59a40dbdc2be294ba1d31866bcbc9cb6e970692b37a270e2c815e0f400c226.tar.xz /
ADD x86_64/6cedb657f66b28b22d838d8957c21793dd5ea89d72a6659d0831f05f3e20a9e4.tar.xz /
ADD x86_64/6d8eb75c29f323e3a36690d6e34d43544385152b96b288c257331df977992532.tar.xz /
ADD x86_64/7cde0ea5795f2c1ea398ad0c3fbfba5c52439e6e8b72e34e05269cbb05cda555.tar.xz /
ADD x86_64/ab1ce61aa99d3c3099462becf42768ea50fc993d546675f6750e16c023fe15f9.tar.xz /
ADD x86_64/aff21d24d56e359f865ddbd8ed0df5d4a9befc1876c4cf1b5eee7a33149ff092.tar.xz /
ADD x86_64/e468fc2ed6ee5be76affa18179ca5b6dedf8df0414aada4383f4ec5c0b2e1ce9.tar.xz /

ENV LANG=en_US.UTF-8
ENV TZ=:/etc/localtime
ENV PATH=/var/lang/bin:/usr/local/bin:/usr/bin/:/bin:/opt/bin
ENV LD_LIBRARY_PATH=/var/lang/lib:/lib64:/usr/lib64:/var/runtime:/var/runtime/lib:/var/task:/var/task/lib:/opt/lib
ENV LAMBDA_TASK_ROOT=/var/task
ENV LAMBDA_RUNTIME_DIR=/var/runtime
ENV DOTNET_VERSION=8.0.34
ENV DOTNET_RUNNING_IN_CONTAINER=true
ENV DOTNET_ROOT=/var/lang/bin
ENV DOTNET_NOLOGO=true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=true

WORKDIR /var/task

ENTRYPOINT ["/lambda-entrypoint.sh"]
